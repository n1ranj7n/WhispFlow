{
  "name": "whispflow",
  "version": "1.0.0",
  "description": "Send files to your WhatsApp contacts from a simple desktop dashboard",
  "author": "Niranjan Subash",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder -mw"
  },
  "dependencies": {
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^22.0.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.niranjan.whispflow",
    "productName": "Whispflow",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "assets/**/*",
      ".pcache/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      ".pcache/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Whispflow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "Whispflow-${version}.${ext}"
    }
  }
}
